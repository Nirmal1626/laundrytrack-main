# Optional. Public site URL used inside WhatsApp tracking links.
# Leave this unset on your own computer. The app uses the address in the browser.
APP_URL=

# Optional. When these three values are real, LaundryTrack sends WhatsApp
# messages through Twilio. When they are blank, the counter opens WhatsApp
# with the tracking link ready to send.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=

JWT_SECRET=replace_with_a_random_secret_of_at_least_32_characters

# Optional. Applied once to all accounts that exist when the store is next used.
# Remove it after initialization; setting it resets those accounts' passwords.
INITIAL_ACCOUNT_PASSWORD=
